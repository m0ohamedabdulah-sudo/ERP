# ============================================================
# Easy Roster — environment template
# Copy to .env and fill in. NEVER commit .env.
#
# RULE: only variables prefixed with NEXT_PUBLIC_ are bundled to the
# browser. Secrets must NEVER use that prefix and must NEVER be read
# by client components.
# ============================================================

# --- Database (used by Prisma, server-only) ---
DATABASE_URL="postgresql://easyroster:easyroster@localhost:5432/easy_roster?schema=public"

# --- Auth (server-only) ---
# Generate with: openssl rand -base64 48
JWT_SECRET="__GENERATE_A_LONG_RANDOM_SECRET__"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Default locale: "ar" or "en"
NEXT_PUBLIC_DEFAULT_LOCALE="ar"

# --- AI (server-only, Phase 16; leave empty until then) ---
# The key is read exclusively by server-side modules (modules/ai).
# It must never be exposed to the frontend.
AI_API_KEY=""
AI_MODEL=""

# --- Postgres (docker-compose, local dev only) ---
POSTGRES_USER="easyroster"
POSTGRES_PASSWORD="easyroster"
POSTGRES_DB="easy_roster"
